# ──────────────────────────────────────────────────────────────────────────
# Caso Durand — variáveis de ambiente
# Copie este arquivo para .env e preencha. NUNCA commite o .env.
# ──────────────────────────────────────────────────────────────────────────

# Banco de dados (Supabase / Postgres, região São Paulo)
# Use a "Connection string" do Supabase. Para o app (serverless), prefira a
# porta 6543 (pooler). Para migrações/seed, a porta 5432 (conexão direta).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require"

# Segredo para assinar as sessões (Auth.js). Gere com: openssl rand -base64 32
AUTH_SECRET="cole-aqui-um-segredo-aleatorio-forte"

# URL pública do site (em produção: https://durand.portinho.me)
AUTH_URL="http://localhost:3000"

# ── Usuários iniciais (usados só pelo `npm run db:seed`) ──
# Senha forte obrigatória: mín. 12 caracteres, com maiúscula, minúscula,
# número e símbolo. Troque depois de criar.
ADMIN_EMAIL="advogado@exemplo.com"
ADMIN_NOME="Dr. Fulano"
ADMIN_SENHA="TroqueEsta!Senha12"

CLIENTE_EMAIL="beto@exemplo.com"
CLIENTE_NOME="José Roberto Durand"
CLIENTE_SENHA="TroqueEsta!Senha34"

# Caminho da planilha-mãe para importação local (não versionada)
IMPORT_FILE="./00_PLANILHA_MAE_Grupo_Durand_v7.xlsx"
