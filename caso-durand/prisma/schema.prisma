// Schema do banco — Caso Durand (M&A)
// Cada grupo de abas da planilha-mãe vira uma tabela. Tabelas transversais
// (User, Empresa, Comentario, AuditLog) conectam tudo.
// Fonte única da verdade após a importação inicial do .xlsx.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (porta 6543) — usado pelo app
  directUrl = env("DIRECT_URL") // conexão direta (5432) — migrações/seed
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN // advogado — edita tudo, exporta, vê auditoria
  CLIENTE // Beto — consulta tudo, edita o permitido
}

enum FaseCronograma {
  ANTES
  DURANTE
  DEPOIS
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum StatusClausula {
  A_REDIGIR
  EM_REVISAO
  PRONTA
}

enum StatusChecklist {
  TEMOS // ✔
  PARCIAL // ◐
  FALTA // ✗
}

enum NivelRisco {
  PROVAVEL
  POSSIVEL
  REMOTO
}

enum CategoriaBem {
  MAQUINARIO
  VEICULO
  AGRICOLA
  OUTRO
}

enum TipoSintese {
  RISCO
  PENDENCIA
}

enum AcaoAudit {
  CREATE
  UPDATE
  DELETE
}

// ─────────────────── Transversais ───────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  senhaHash String
  role      Role     @default(CLIENTE)
  createdAt DateTime @default(now())

  comentarios Comentario[]
  auditorias  AuditLog[]
}

model Empresa {
  id    String  @id @default(cuid())
  nome  String  @unique // Plásticos Barueri | JRPlastic | Plast Log | Pomar
  cnpj  String?
  apelido String?

  tarefas         Tarefa[]
  checklistItems  ChecklistItem[]
  certidoes       Certidao[]
  contingencias   Contingencia[]
  passivosResumo  PassivoResumo[]
  emprestimos     Emprestimo[]
  dividasFiscais  DividaFiscal[]
  garantias       Garantia[]
  titularidades   Titularidade[]
  patrimonios     Patrimonio[]
  bens            Bem[]
}

// Comentário/observação polimórfico: aplica-se a qualquer item de qualquer seção.
model Comentario {
  id         String   @id @default(cuid())
  entidade   String // nome da tabela alvo, ex.: "Certidao"
  entidadeId String
  texto      String
  autor      User     @relation(fields: [autorId], references: [id])
  autorId    String
  createdAt  DateTime @default(now())

  @@index([entidade, entidadeId])
}

// Trilha de auditoria: autor + timestamp + campo alterado.
model AuditLog {
  id          String    @id @default(cuid())
  entidade    String
  entidadeId  String
  campo       String?
  valorAntigo String?
  valorNovo   String?
  acao        AcaoAudit
  autor       User      @relation(fields: [autorId], references: [id])
  autorId     String
  createdAt   DateTime  @default(now())

  @@index([entidade, entidadeId])
  @@index([createdAt])
}

// ─────────────────── Negócio ───────────────────

// CRON — Cronograma 3 meses
model Tarefa {
  id          String         @id @default(cuid())
  titulo      String
  fase        FaseCronograma
  semana      Int?
  responsavel String?
  status      StatusTarefa   @default(PENDENTE)
  inicio      DateTime?
  fim         DateTime?
  observacao  String?
  empresa     Empresa?       @relation(fields: [empresaId], references: [id])
  empresaId   String?
  ordem       Int            @default(0)
}

// CLAU — Cláusulas Contratuais (22)
model Clausula {
  id              String         @id @default(cuid())
  numero          Int
  titulo          String
  finalidade      String?
  anexoVinculado  String?
  status          StatusClausula @default(A_REDIGIR)
  observacao      String?
  ordem           Int            @default(0)
}

// CHECK — Checklist e Pendências
model ChecklistItem {
  id          String          @id @default(cuid())
  item        String
  categoria   String?
  status      StatusChecklist @default(FALTA)
  providencia String?
  resolvido   Boolean         @default(false)
  empresa     Empresa?        @relation(fields: [empresaId], references: [id])
  empresaId   String?
  ordem       Int             @default(0)
}

// CERT — Controle de Certidões (~70)
model Certidao {
  id        String    @id @default(cuid())
  titular   String
  cpfCnpj   String?
  orgao     String?
  tipo      String?
  situacao  String?
  emissao   DateTime?
  validade  DateTime?
  numero    String?
  link      String?
  empresa   Empresa?  @relation(fields: [empresaId], references: [id])
  empresaId String?
  ordem     Int       @default(0)
}

// CONT — Contingências (processos judiciais)
model Contingencia {
  id             String     @id @default(cuid())
  numeroProcesso String?
  classe         String?
  foro           String?
  valorCausa     Decimal?   @db.Decimal(15, 2)
  risco          NivelRisco @default(POSSIVEL)
  valorEmRisco   Decimal?   @db.Decimal(15, 2)
  recomendacao   String?
  empresa        Empresa?   @relation(fields: [empresaId], references: [id])
  empresaId      String?
  ordem          Int        @default(0)
}

// PASS — Resumo (consolidação de passivos por empresa)
model PassivoResumo {
  id             String   @id @default(cuid())
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  empresaId      String
  emprestimos    Decimal? @db.Decimal(15, 2)
  dividasFiscais Decimal? @db.Decimal(15, 2)
  total          Decimal? @db.Decimal(15, 2)
  ordem          Int      @default(0)
}

// PASS — Empréstimos (contratos bancários)
model Emprestimo {
  id         String    @id @default(cuid())
  empresa    Empresa?  @relation(fields: [empresaId], references: [id])
  empresaId  String?
  banco      String?
  operacao   String?
  saldo      Decimal?  @db.Decimal(15, 2)
  parcela    Decimal?  @db.Decimal(15, 2)
  taxa       String?
  vencimento DateTime?
  observacao String?
  ordem      Int       @default(0)
}

// PASS — Dívidas Fiscais (parcelamentos)
model DividaFiscal {
  id                String    @id @default(cuid())
  empresa           Empresa?  @relation(fields: [empresaId], references: [id])
  empresaId         String?
  orgao             String? // PGFN / RECEITA / SEFAZ
  modalidade        String?
  adesao            DateTime?
  valorConsolidado  Decimal?  @db.Decimal(15, 2)
  saldo             Decimal?  @db.Decimal(15, 2)
  observacao        String?
  ordem             Int       @default(0)
}

// PASS — Garantias e Avais
model Garantia {
  id          String   @id @default(cuid())
  tipo        String?
  descricao   String
  pontoCritico Boolean @default(false)
  empresa     Empresa? @relation(fields: [empresaId], references: [id])
  empresaId   String?
  ordem       Int      @default(0)
}

// PASS — Consolidado (Cliente) — cruzamento cliente x base documentada
model ConsolidadoCliente {
  id          String   @id @default(cuid())
  item        String
  valorCliente Decimal? @db.Decimal(15, 2)
  valorBase    Decimal? @db.Decimal(15, 2)
  divergencia  Boolean  @default(false)
  observacao   String?
  ordem        Int      @default(0)
}

// SOC-1 — Empresas (quadro societário)
model Sociedade {
  id         String  @id @default(cuid())
  razaoSocial String
  cnpj       String?
  objeto     String?
  sede       String?
  capital    Decimal? @db.Decimal(15, 2)
  socios     String?
  ordem      Int     @default(0)
}

// SOC-2 — Imóveis (Pomar)
model Imovel {
  id            String  @id @default(cuid())
  matricula     String?
  descricao     String
  gravames      String?
  ativoBiologico String? // bloco "pomar como ativo biológico" (laudo pendente)
  ordem         Int     @default(0)
}

// SOC-3 — Pessoas (qualificação das pessoas físicas)
model Pessoa {
  id        String  @id @default(cuid())
  nome      String
  cpf       String?
  rg        String?
  regimeBens String?
  endereco  String?
  ordem     Int     @default(0)
}

// SOC-4 — Quem vende (titularidade formal x economia real)
model Titularidade {
  id            String   @id @default(cuid())
  negocio       String
  titularFormal String?
  economiaReal  String? // ex.: "50%"
  empresa       Empresa? @relation(fields: [empresaId], references: [id])
  empresaId     String?
  ordem         Int      @default(0)
}

// SOC-5 — Síntese e pendências
model SintesePendencia {
  id        String      @id @default(cuid())
  titulo    String
  descricao String?
  tipo      TipoSintese @default(PENDENCIA)
  ordem     Int         @default(0)
}

// PATR — Resumo (patrimônio consolidado)
model Patrimonio {
  id        String   @id @default(cuid())
  empresa   Empresa? @relation(fields: [empresaId], references: [id])
  empresaId String?
  categoria String?
  valor     Decimal? @db.Decimal(15, 2)
  ordem     Int      @default(0)
}

// PATR — Bens Santa Lucia / Máquinas Plast Log / Veículos (consolidados)
model Bem {
  id           String       @id @default(cuid())
  categoria    CategoriaBem @default(OUTRO)
  descricao    String
  identificador String? // placa / RENAVAM / nº de série
  valor        Decimal?     @db.Decimal(15, 2)
  gravame      String? // alienação fiduciária etc.
  empresa      Empresa?     @relation(fields: [empresaId], references: [id])
  empresaId    String?
  ordem        Int          @default(0)
}
